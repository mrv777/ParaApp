# Expo/React Native release bundling resolves some Babel plugins by name from the
# project root (e.g. @babel/plugin-transform-react-jsx in the production preset).
# pnpm's isolated store hides these, breaking `createBundleReleaseJsAndAssets`.
# Hoist the @babel scope to the top-level node_modules so Babel can resolve them.
public-hoist-pattern[]=@babel/*
