{
  "expo": {
    "name": "ParaApp",
    "slug": "paraapp",
    "version": "0.6.4",
    "scheme": "paraapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.parasite.paraapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "backgroundColor": "#FFFFFF",
      "predictiveBackGestureEnabled": false,
      "package": "app.paraapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-network-security-config",
        {
          "networkSecurityConfig": "./assets/network_security_config.xml",
          "enable": true
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to scan Bitcoin address QR codes"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ededed",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.app.parasite.paraapp",
          "widgets": [
            {
              "name": "PersonalMiningWidget",
              "displayName": "Personal Mining",
              "description": "Shows your Parasite Pool mining status.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ]
            },
            {
              "name": "PoolOverviewWidget",
              "displayName": "Pool Overview",
              "description": "Shows Parasite Pool hashrate and worker status.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryRectangular"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "PersonalMiningWidget",
              "label": "Personal Mining",
              "description": "Shows your Parasite Pool mining status.",
              "minWidth": "140dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PoolOverviewWidget",
              "label": "Pool Overview",
              "description": "Shows Parasite Pool hashrate and worker status.",
              "minWidth": "140dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "200dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-background-task",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8817e235-92a0-49f8-a726-5b010ee55f0b"
      },
      "pushApiUrl": "https://paraapp-notifications.7fmqnkfyfq.workers.dev"
    },
    "owner": "mrv-matrica"
  }
}
